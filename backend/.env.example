# Local Docker: node scripts/init-env.mjs generates backend/.env safely.
# Production: set these through your provider's secret manager.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://radice:REPLACE@postgres:5432/radice?sslmode=verify-full
REDIS_URL=rediss://REPLACE
APP_ORIGIN=https://radice.example
DATA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
OTP_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=true
# Optional comma-separated trusted proxy IPs/CIDRs; never enable blindly.
# TRUST_PROXY=10.0.0.0/8
SMTP_HOST=smtp.example
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE
SMTP_PASS=REPLACE
MAIL_FROM=Radice <noreply@example.com>
S3_BUCKET=radice-private
S3_REGION=eu-west-1
# Omit endpoint and keys on AWS when using IAM role credentials.
# S3_ENDPOINT=https://s3-compatible.example
# S3_PUBLIC_ENDPOINT=https://s3-compatible.example
S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY=REPLACE
# S3_SECRET_KEY=REPLACE
ZOOM_ACCOUNT_ID=REPLACE
ZOOM_CLIENT_ID=REPLACE
ZOOM_CLIENT_SECRET=REPLACE
ZOOM_WEBHOOK_SECRET=REPLACE
STRIPE_SECRET_KEY=REPLACE
STRIPE_WEBHOOK_SECRET=REPLACE
DB_POOL_MAX=10
