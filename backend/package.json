{
  "name": "radice-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "admin": "tsx src/create-admin.ts",
    "test": "tsx --test --test-concurrency=1 test/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test public scripts/*.mjs",
    "format:check": "prettier --check src test public scripts/*.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/lib-storage": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.8.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "stripe": "^19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
